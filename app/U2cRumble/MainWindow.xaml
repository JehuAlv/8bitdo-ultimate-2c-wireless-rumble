<Window x:Class="U2cRumble.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="8BitDo Ultimate 2C Wireless - Bluetooth Rumble &amp; XInput"
        Height="680" Width="860" MinHeight="540" MinWidth="720"
        Background="#fafafa"
        FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,10"
                   Text="8BitDo Ultimate 2C Wireless - Bluetooth Rumble &amp; XInput"/>

        <TabControl Grid.Row="1" Padding="8">
            <TabItem Header="Setup">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#ffffff" BorderBrush="#e0e0e0"
                            BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Controller status" FontWeight="SemiBold"/>
                            <TextBlock x:Name="StatusText" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Foreground="#555555" Text="Checking..."/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="RefreshButton" Content="Refresh" Padding="12,6"
                                Click="Refresh_Click"/>
                        <Button x:Name="BackupButton" Content="Back up controller" Padding="12,6"
                                Margin="8,0,0,0" Click="Backup_Click"/>
                        <Button x:Name="CheckButton" Content="Check (no write)" Padding="12,6"
                                Margin="8,0,0,0" Click="Check_Click"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="InstallButton" Content="Install Bluetooth rumble" Padding="12,6"
                                Click="Install_Click"/>
                        <Button x:Name="RestoreButton" Content="Restore backup" Padding="12,6"
                                Margin="8,0,0,0" Click="Restore_Click"/>
                    </StackPanel>

                    <CheckBox x:Name="DisclaimerCheck" Grid.Row="3" Margin="0,14,0,0"
                              Checked="Disclaimer_Changed" Unchecked="Disclaimer_Changed"
                              Content="I understand this modifies the controller's firmware and probably voids its warranty."/>

                    <TextBox x:Name="LogBox" Grid.Row="4" Margin="0,10,0,0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12" Background="#ffffff"
                             BorderBrush="#e0e0e0" Padding="6"/>
                </Grid>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="What this does"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Out of the box, over Bluetooth, the 8BitDo Ultimate 2C Wireless is a plain HID gamepad on Windows: it does not rumble, and many games do not recognise it. This app converts it to XInput over Bluetooth by flashing 8BitDo's own firmware with two small tweaks, so the controller reports as an Xbox Series X|S pad (045e:0b13) and vibrates over Bluetooth. The change lives inside the controller, so it works on any Windows PC after one flash. No drivers, no dongle and no virtual pad."/>

                        <TextBlock Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" Text="How to use"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="1. Connect the controller with the USB cable.&#10;2. Back up controller (the safety net; the tool refuses to write without a backup).&#10;3. Check (no write) to see what would change.&#10;4. Tick the box and press Install Bluetooth rumble.&#10;5. Unplug, remove the controller in Windows Bluetooth settings, pair it again and play.&#10;&#10;To undo it, restore the backup the same way. The bootloader is never written, so recovery over USB is always possible: turn the controller off, hold L1 + R1 and plug in the cable."/>

                        <TextBlock Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" Text="Credits"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="The flashing core is a C# port of the U2C Firmware Toolkit by Carlos Browne F. (GPL-3.0-or-later), which provides the bt_xbox and bt_rumble tweaks and all the reverse engineering behind them. The update and bootloader protocols come from jgus-org/8bitdo-2c-re-flake (MIT). See CREDITS.md for the full list."/>

                        <TextBlock Margin="0,14,0,0" FontSize="15" FontWeight="SemiBold" Text="License"/>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="GPL-3.0-or-later. Not affiliated with or endorsed by 8BitDo. Installing modified firmware probably voids your controller's warranty."/>

                        <TextBlock x:Name="VersionText" Margin="0,14,0,0" Foreground="#777777"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
