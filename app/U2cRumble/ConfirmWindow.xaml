<Window x:Class="U2cRumble.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="22,20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" CornerRadius="10" Background="#241C10" VerticalAlignment="Top">
                    <Path Data="{StaticResource IconWarning}" Width="19" Height="19" Stretch="Uniform"
                          Fill="{StaticResource WarnBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" Margin="13,0,0,0" Style="{StaticResource H2}"
                           FontSize="17" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Muted}" Margin="0,14,0,0"
                       FontSize="13" LineHeight="20"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelButton" AutomationProperties.AutomationId="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel"
                        Click="Cancel_Click" IsCancel="True"/>
                <Button x:Name="ConfirmButton" AutomationProperties.AutomationId="ConfirmButton" Style="{StaticResource PrimaryButton}" Height="38" Margin="9,0,0,0"
                        Click="Confirm_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
