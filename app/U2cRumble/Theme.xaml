<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- palette -->
    <Color x:Key="BgColor">#0B0D12</Color>
    <Color x:Key="SurfaceColor">#131722</Color>
    <Color x:Key="SurfaceAltColor">#1A2030</Color>
    <Color x:Key="BorderColor">#232C3D</Color>
    <Color x:Key="TextColor">#E9EDF6</Color>
    <Color x:Key="MutedColor">#96A2BA</Color>
    <Color x:Key="AccentColor">#7C5CFF</Color>
    <Color x:Key="Accent2Color">#22D3EE</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F87171</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CFF" Offset="0"/>
        <GradientStop Color="#6D5BFF" Offset="0.55"/>
        <GradientStop Color="#3FC9F0" Offset="1"/>
    </LinearGradientBrush>

    <!-- same colours and layers as Assets/app.ico, so the logo matches the exe -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8B6CFF" Offset="0"/>
        <GradientStop Color="#6355F5" Offset="0.42"/>
        <GradientStop Color="#2E7FEA" Offset="0.76"/>
        <GradientStop Color="#22C8E6" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="BrandGloss" Center="0.26,0.1" GradientOrigin="0.26,0.1" RadiusX="0.9" RadiusY="0.9">
        <GradientStop Color="#42FFFFFF" Offset="0"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </RadialGradientBrush>
    <LinearGradientBrush x:Key="BrandDepth" StartPoint="0,0.45" EndPoint="0,1">
        <GradientStop Color="#002A1A86" Offset="0"/>
        <GradientStop Color="#382A1A86" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeroGlow" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A1F5C" Offset="0"/>
        <GradientStop Color="#141828" Offset="1"/>
    </LinearGradientBrush>

